# ═══════════════════════════════════════════════════════════════
# MarketPulse V4 — Vibe-Trading .env (llama-cpp via Tailscale)
# ═══════════════════════════════════════════════════════════════
# setup_vps.sh will copy this to ~/vibe-trading/agent/.env
# and substitute <LLM_TAILSCALE_IP>.
# You can also edit this file manually before running setup.

# ── LLM Provider: llama-cpp-server on Windows host via Tailscale ──
# llama-server exposes an OpenAI-compatible API at /v1
# Windows host runs: llama-server.exe --host 0.0.0.0 --port 8090
LANGCHAIN_PROVIDER=openai
OPENAI_BASE_URL=http://<LLM_TAILSCALE_IP>:8090/v1
OPENAI_API_KEY=local
LANGCHAIN_MODEL_NAME=ministral-3b

# Inference settings — keep temperature at 0 for deterministic signals
LANGCHAIN_TEMPERATURE=0.0
TIMEOUT_SECONDS=120
MAX_RETRIES=2

# ── Data Sources ──────────────────────────────────────────────
# yfinance works out-of-the-box (no key required) for US/HK equities.
# Leave TUSHARE_TOKEN blank unless you have A-share access.
TUSHARE_TOKEN=

# ── API Server ────────────────────────────────────────────────
# The API binds to 127.0.0.1 inside Docker; access via Tailscale tunnel.
# Set a strong random string here — required for any non-loopback caller.
API_AUTH_KEY=CHANGE_ME_BEFORE_DEPLOY

# Optional CORS origins (comma-separated). Leave blank for localhost-only.
API_CORS_ORIGINS=

# ── Agent Tuning ──────────────────────────────────────────────
SWARM_WORKER_TIMEOUT=300
MAX_AGENT_ITERATIONS=20

# ── Shell Tools (disabled by default for security) ────────────
# Uncomment only after reviewing implications for remote deployments.
# VIBE_TRADING_ENABLE_SHELL_TOOLS=1
